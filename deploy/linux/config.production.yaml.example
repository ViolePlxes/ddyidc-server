Name: ddyidc-server
Host: 127.0.0.1
Port: 8080
Mode: pro
DeploymentEnvironment: production
Timeout: 120000

# Only the local reverse proxy can supply the client forwarding chain.
Network:
  TrustedProxies:
    - 127.0.0.1/32
    - ::1/128

MySQL:
  Host: 127.0.0.1
  Port: 3306
  User: ddyidc_runtime
  Password: "__MYSQL_PASSWORD__"
  Database: ddyidc
  MaxOpenConns: 100
  MaxIdleConns: 20
  ConnMaxLifetime: 3600

Redis:
  Host: 127.0.0.1
  Port: 6379
  Password: "__REDIS_PASSWORD__"
  DB: 0
  PoolSize: 100

Crypto:
  AESKey: "__AES_KEY__"

JWT:
  AccessSecret: "__JWT_ACCESS_SECRET__"
  AccessExpire: 7200
  RefreshSecret: "__JWT_REFRESH_SECRET__"
  RefreshExpire: 604800

Runtime:
  DataDir: /var/lib/ddyidc

Log:
  Level: info
  Mode: file
  Path: /var/lib/ddyidc/logs
  KeepDays: 30

Notify:
  Mock: false
  SMS:
    AccessKey: ""
    AccessSecret: ""
    SignName: ""
  Mail:
    Host: ""
    Port: 465
    Username: ""
    Password: ""
    FromName: "DDYIDC"

RemoteConsole:
  Engine: novnc

# Visit analytics: privacy-bounded page and API statistics for the admin home.
# Disabled is the only kill switch; omitted keys keep the documented defaults.
VisitAnalytics:
  Disabled: false
  PageSamplePercent: 100
  APISamplePercent: 10
  MaxEventsPerSecond: 5000
  BatchSize: 200
  FlushMillis: 2000
  QueueSize: 8192
  RetentionDays: 90
  # Offline ip2region xdb inside Runtime.DataDir. Leave empty or unset to record
  # every region as unknown; no online lookup is ever performed.
  GeoIPFile: /var/lib/ddyidc/storage/geoip/ip2region.xdb
  GeoIPReloadMinutes: 60

Payment:
  AlipaySecretFile: /etc/ddyidc/secrets/alipay.json

Update:
  GitPath: /usr/bin/git
  GoPath: /usr/local/go/bin/go
  NPMPath: /usr/local/bin/npm
  SystemctlPath: /usr/bin/systemctl
  SudoPath: /usr/bin/sudo
  ServerService: ddyidc.service
  UpdateHelperService: ddyidc-update-helper.service
  MinFreeMB: 10240
  TimeoutSeconds: 600
  HealthURL: http://127.0.0.1:8080/health
  VersionURL: http://127.0.0.1:8080/api/v1/system/version
  SmokeURL: http://127.0.0.1:8080/api/v1/products
  ResultDir: /var/lib/ddyidc/update-results
  Backend:
    Workspace: /var/lib/ddyidc/update/workspaces/backend
    Branch: main
    Executable: /opt/ddyidc/application/ddyidc-server
    ConfigFile: /etc/ddyidc/config.yaml
    HelperPath: /opt/ddyidc/bin/ddyidc-update-helper
  Frontend:
    Workspace: /var/lib/ddyidc/update/workspaces/frontend
    Branch: main
    StaticURL: http://127.0.0.1:8081/
