[Unit]
Description=DDYIDC production update resource reclamation
After=ddyidc.service mysql.service redis-server.service
ConditionPathExists=/etc/ddyidc/reclamation-production.json
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/ddyidc/bin/ddyidc-resource-reclamation
TimeoutStartSec=10min
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ddyidc-build/jobs /var/lib/ddyidc/update-results /var/lib/ddyidc/update/workspaces/frontend /var/lib/ddyidc/backups /run
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal
