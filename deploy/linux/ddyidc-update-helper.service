[Unit]
Description=DDYIDC atomic update helper
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/ddyidc/update-results/pending.plan.json

[Service]
Type=oneshot
User=ddyidc
Group=ddyidc
UMask=0027
WorkingDirectory=/var/lib/ddyidc
StateDirectory=ddyidc
StateDirectoryMode=0751
Environment=HOME=/var/lib/ddyidc/home TMPDIR=/var/lib/ddyidc/tmp XDG_CACHE_HOME=/var/lib/ddyidc/cache GOCACHE=/var/lib/ddyidc/cache/go-build GOMODCACHE=/var/lib/ddyidc/cache/go-mod NPM_CONFIG_CACHE=/var/lib/ddyidc/cache/npm
ExecStartPre=/opt/ddyidc/deploy/disk-guard.sh --admit
ExecStart=/opt/ddyidc/bin/ddyidc-update-helper -plan /var/lib/ddyidc/update-results/pending.plan.json
TimeoutStartSec=15min
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/ddyidc /opt/ddyidc/application
ReadOnlyPaths=/etc/ddyidc /tmp /var/tmp /opt/ddyidc/bin /opt/ddyidc/deploy
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ddyidc-update-helper
