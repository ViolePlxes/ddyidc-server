[Unit]
Description=DDYIDC API service
Wants=network-online.target
After=network-online.target mysql.service redis-server.service
RequiresMountsFor=/opt/ddyidc /var/lib/ddyidc/logs

[Service]
Type=simple
User=ddyidc
Group=ddyidc
# The visit analytics reader needs read access to the nginx JSON access log
# (0640 www-data adm); no other permission on /var/log/nginx is granted.
SupplementaryGroups=adm
WorkingDirectory=/var/lib/ddyidc
StateDirectory=ddyidc
StateDirectoryMode=0751
Environment=HOME=/var/lib/ddyidc/home TMPDIR=/var/lib/ddyidc/tmp XDG_CACHE_HOME=/var/lib/ddyidc/cache GOCACHE=/var/lib/ddyidc/cache/go-build GOMODCACHE=/var/lib/ddyidc/cache/go-mod NPM_CONFIG_CACHE=/var/lib/ddyidc/cache/npm
UMask=0027
ExecStartPre=/opt/ddyidc/deploy/wait-dependencies.sh
ExecStartPre=/opt/ddyidc/deploy/disk-guard.sh --admit
ExecStart=/opt/ddyidc/bin/ddyidc-server -f /etc/ddyidc/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65535
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/ddyidc
ReadOnlyPaths=/etc/ddyidc /tmp /var/tmp
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ddyidc

[Install]
WantedBy=multi-user.target
