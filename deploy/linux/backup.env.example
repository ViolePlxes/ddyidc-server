# Installed as /etc/ddyidc/backup.env with mode 0600.
BACKUP_ROOT=/var/lib/ddyidc/backups
MYSQL_DATA_DIR=/var/lib/mysql
REDIS_DATA_DIR=/var/lib/redis
REDIS_PASSWORD_FILE=/etc/ddyidc/secrets/redis-password

# Deprecated: legacy archive uploads are disabled because they can contain secrets.
# Configure private OSS business backups in /admin/backups instead.
OBJECT_STORAGE_URI=
AWS_ENDPOINT_URL=
