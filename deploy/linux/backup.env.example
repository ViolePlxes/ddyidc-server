# Installed as /etc/ddyidc/backup.env with mode 0600.
BACKUP_ROOT=/var/backups/ddyidc
MYSQL_DATA_DIR=/var/lib/mysql
REDIS_DATA_DIR=/var/lib/redis
REDIS_PASSWORD_FILE=/etc/ddyidc/secrets/redis-password

# Optional S3-compatible destination, for example s3://company-backups/ddyidc.
# Configure credentials outside Git using an IAM role or a mode-0600 AWS credentials file.
OBJECT_STORAGE_URI=
AWS_ENDPOINT_URL=
