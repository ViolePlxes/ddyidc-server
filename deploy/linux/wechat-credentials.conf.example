# Optional systemd drop-in after installing the two files as root:ddyidc 0600.
# Never copy key contents into this file. Missing/unreadable credentials fail
# service startup rather than silently disabling callback verification.
[Service]
LoadCredential=wechatpay_public_key.pem:/etc/ddyidc/secrets/wechatpay_public_key.pem
LoadCredential=wechatpay_public_key_id:/etc/ddyidc/secrets/wechatpay_public_key_id
